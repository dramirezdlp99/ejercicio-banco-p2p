# RabbitMQ (Docker en EC2 Services) — ajustar la IP privada de `ec2-services`
# Ejemplo: RABBITMQ_URL=amqp://admin:CHANGE_ME@10.0.1.X:5672
RABBITMQ_URL=amqp://admin:CHANGE_ME@10.0.1.X:5672

# RabbitMQ Management API (para stats del dashboard)
# Ejemplo: RABBITMQ_HTTP_API=http://10.0.1.X:15672
RABBITMQ_HTTP_API=http://10.0.1.X:15672
RABBITMQ_USER=admin
RABBITMQ_PASS=CHANGE_ME

# Apache Kafka — IP privada del ec2-kafka-node
KAFKA_BROKER=10.0.1.x:9092

# SECURITY NOTE: Do not commit real credentials. Copy this file to .env and
# fill secrets using GitHub Secrets, SSM, or Secrets Manager in production.
